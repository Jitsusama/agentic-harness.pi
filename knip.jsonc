// knip finds code nothing reads: files no entry reaches, dependencies
// nothing uses or nothing lists, and exports nobody imports. The package's
// own exports, in package.json, are entries knip reads by itself.
{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	"entry": [
		// What pi loads: every extension, and the packs a subagent loads.
		"extensions/*/index.ts",
		"packs/*/index.ts",
		"host/*/index.ts",
		// Programs run by hand, by pnpm or by node directly.
		"scripts/*.ts",
		"lib/**/*.mjs",
		// The tests and their configs.
		"tests/**/*.test.ts",
		// Programs a test runs in a node of its own.
		"tests/**/fixtures/*.mts",
		"vitest*.config.ts",
		// The engines a sealed host process imports by path, whose `engine`
		// no static import names.
		"tests/host/end-to-end/support/fake-engine.ts",
		"tests/host/end-to-end/support/pi-engine.ts",
		// The extension a sealed plain pi loads by path, with `-e`.
		"tests/host/end-to-end/support/scripted-provider.ts"
	],
	"project": [
		"extensions/**/*.ts",
		"host/**/*.ts",
		"lib/**/*.{ts,mjs}",
		"packs/**/*.ts",
		"scripts/**/*.ts",
		"tests/**/*.ts",
		"tests/**/*.mts"
	],
	// pi maps @sinclair/typebox onto the typebox it bundles at runtime, and
	// vitest.config.ts and tsconfig.json copy that mapping onto ours, so
	// the name is imported but never installed.
	"ignoreDependencies": ["@sinclair/typebox"],
	// Programs the machine provides, never an npm package's binaries.
	"ignoreBinaries": [
		"btrfs",
		"devx",
		"kitty",
		"mycelium",
		"nix-store",
		"perl",
		"pgrep",
		"pkill",
		"qs",
		"script",
		"session-backup",
		"systemd-notify",
		"xdg-open"
	],
	// knip 6.44.1 resolves the paths of a package script a source file
	// runs from that file's folder, not the package's (expandScript, in
	// dist/binaries/util.js), so test:host's reporter, which
	// scripts/host-prove.ts runs, looks missing. Try dropping this when
	// knip moves.
	"ignoreUnresolved": [
		"^\\./tests/host/end-to-end/support/every-case-ran\\.mts$"
	],
	// An export a file also uses itself is no dead code.
	"ignoreExportsUsedInFile": true
}
