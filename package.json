{
	"name": "agentic-harness.pi",
	"version": "0.1.0",
	"description": "Collaborative coding workflows for pi: planning, TDD, git hygiene, and code investigation.",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"exports": {
		"./guardian": "./lib/guardian/index.ts",
		"./shell": "./lib/shell/index.ts",
		"./ui": "./lib/ui/index.ts",
		"./slack": "./lib/slack/index.ts",
		"./slack/auth": "./lib/slack/auth/index.ts",
		"./google": "./lib/google/index.ts",
		"./google/auth": "./lib/google/auth/index.ts",
		"./glossary": "./lib/glossary/index.ts",
		"./budget": "./lib/budget/index.ts",
		"./clock": "./lib/clock/index.ts",
		"./command": "./lib/command/index.ts",
		"./subagent": "./lib/subagent/index.ts",
		"./refs": "./lib/refs/index.ts",
		"./people": "./lib/people/index.ts",
		"./terminal": "./lib/terminal/index.ts",
		"./quest": "./lib/quest/index.ts",
		"./prompt": "./lib/prompt/index.ts",
		"./compaction": "./lib/compaction/index.ts",
		"./mcp": "./lib/mcp/index.ts",
		"./jobs": "./lib/jobs/index.ts",
		"./core/exec": "./lib/core/exec/index.ts",
		"./core/quest": "./lib/quest/index.ts",
		"./core/quest/config": "./lib/core/quest/config.ts",
		"./core/result": "./lib/core/result/index.ts",
		"./core/session": "./lib/core/session/index.ts",
		"./core/review": "./lib/core/review/index.ts",
		"./core/tree": "./lib/core/tree/index.ts",
		"./core/work": "./lib/core/work/index.ts",
		"./ts-import-specifiers": "./scripts/ts-import-specifiers.ts"
	},
	"scripts": {
		"check": "pnpm lint && pnpm typecheck && pnpm typecheck:indexed && pnpm knip && vitest run --changed origin/main && pnpm test:browser:changed && pnpm load-check",
		"check:there": "bash scripts/check-there.sh",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"typecheck:indexed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/indexed-access.ts",
		"knip": "knip --no-progress",
		"load-check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/load-check.ts --production",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:changed": "vitest run --changed origin/main",
		"test:host": "PI_HOST_REQUIRED=1 PI_HOST_RUNTIME=\"${PI_HOST_RUNTIME:-${XDG_STATE_HOME:-$HOME/.local/state}/pi-host/runtime}\" vitest run --project process --reporter=default --reporter=./tests/host/end-to-end/support/every-case-ran.mts tests/host/end-to-end tests/host/engine tests/host/parity tests/host/soak/soak.test.ts",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:browser:changed": "vitest run --config vitest.browser.config.ts --changed origin/main",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"packageManager": "pnpm@12.9.0",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"skills": [
			"./skills",
			"!skills/review-*-format"
		],
		"sessionStateKeyed": true
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"axe-core": "^4.12.1",
		"defuddle": "^0.19.1",
		"google-auth-library": "^10.9.0",
		"googleapis": "^173.0.0",
		"jsdom": "^29.1.1",
		"jsonpath-plus": "^10.4.0",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"puppeteer-core": "^25.3.0",
		"sqlite3": "^6.0.1",
		"vscode-jsonrpc": "^9.0.1",
		"vscode-languageserver-protocol": "^3.18.2",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@babel/parser": "^7.29.7",
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^26.1.1",
		"@types/pngjs": "^6.0.5",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@xterm/headless": "5.5.0",
		"knip": "^6.44.1",
		"typebox": "^1.3.6",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"ws": "^8.21.1"
	}
}
