{
	"name": "agentic-harness.pi",
	"version": "0.1.0",
	"description": "Collaborative coding workflows for pi: planning, TDD, git hygiene, and code investigation.",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"exports": {
		"./guardian": "./lib/guardian/index.ts",
		"./shell": "./lib/shell/index.ts",
		"./ui": "./lib/ui/index.ts",
		"./slack": "./lib/slack/index.ts",
		"./slack/api": "./lib/slack/api/index.ts",
		"./slack/auth": "./lib/slack/auth/index.ts",
		"./slack/renderers": "./lib/slack/renderers/index.ts",
		"./slack/resolvers": "./lib/slack/resolvers/index.ts",
		"./google": "./lib/google/index.ts",
		"./google/apis": "./lib/google/apis/index.ts",
		"./google/auth": "./lib/google/auth/index.ts",
		"./google/renderers": "./lib/google/renderers/index.ts",
		"./web": "./lib/web/index.ts",
		"./work": "./lib/work/index.ts",
		"./clock": "./lib/clock/index.ts",
		"./exec": "./lib/exec/index.ts",
		"./process": "./lib/process/index.ts",
		"./remote": "./lib/remote/index.ts",
		"./command": "./lib/command/index.ts",
		"./subagent": "./lib/subagent/index.ts",
		"./refs": "./lib/refs/index.ts",
		"./people": "./lib/people/index.ts",
		"./terminal": "./lib/terminal/index.ts",
		"./quest": "./lib/quest/index.ts",
		"./tree": "./lib/tree/index.ts",
		"./mcp": "./lib/mcp/index.ts"
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:browser": "PI_RACE_TESTS=1 vitest run tests/browser"
	},
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=22.19.0"
	},
	"pnpm": {
		"overrides": {
			"google-auth-library": "10.9.0"
		}
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"skills": [
			"./skills"
		]
	},
	"dependencies": {
		"@jitsusama/agentic-harness.core": "github:Jitsusama/agentic-harness.core",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"axe-core": "^4.12.1",
		"defuddle": "^0.19.1",
		"google-auth-library": "^10.9.0",
		"googleapis": "^173.0.0",
		"jsdom": "^29.1.1",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"puppeteer-core": "^25.3.0",
		"sqlite3": "^6.0.1",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@earendil-works/pi-ai": "^0.80.7",
		"@earendil-works/pi-coding-agent": "^0.80.7",
		"@earendil-works/pi-tui": "^0.80.7",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^26.1.1",
		"@types/pngjs": "^6.0.5",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@xterm/headless": "5.5.0",
		"typebox": "^1.3.6",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"ws": "^8.21.1"
	}
}
